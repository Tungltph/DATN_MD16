<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/black</item>
        <item name="android:textColorPrimary">@android:color/black</item> <!-- Set default text color to black -->
    </style>

    <!-- Custom toolbar style -->
    <style name="CustomToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:titleTextColor">@android:color/black</item>
        <item name="android:subtitleTextColor">@android:color/black</item>
    </style>
</resources>
