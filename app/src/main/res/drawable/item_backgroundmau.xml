<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State selected: when the item is selected -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>
            <stroke android:width="2dp" android:color="#E40A0A"/> <!-- Viền màu đỏ -->
            <corners android:radius="4dp"/> <!-- Bo góc nếu cần -->
        </shape>
    </item>
    <!-- Default state: when the item is not selected -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white"/>
            <stroke android:width="1dp" android:color="@android:color/darker_gray"/> <!-- Viền màu xám tối -->
            <corners android:radius="4dp"/> <!-- Bo góc nếu cần -->
        </shape>
    </item>
</selector>
