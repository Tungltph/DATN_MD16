<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/border"
        android:gravity="center">

        <ImageView
            android:id="@+id/imgSanPhamYT"
            android:layout_width="120dp"
            android:layout_height="150dp"
            android:src="@drawable/img_1"
            android:contentDescription="@string/product_image"
            android:layout_gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvTenYT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="iPhone 15 Pro"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:gravity="center"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvGiaGiamYT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10.000.000đ"
                android:textColor="#FF00"
                android:textStyle="bold"
                android:textSize="12dp"
                android:paddingTop="4dp" />

            <TextView
                android:id="@+id/tvGiaGocYT"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10.000.000đ"
                android:layout_marginStart="10dp"
                android:textSize="8sp"
                android:paddingTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_margin="5dp">

        <ImageView
            android:id="@+id/img_sale"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/img_7" />

        <TextView
            android:id="@+id/tv_phanTram_YT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="-12%"
            android:textColor="@color/white"
            android:textSize="9dp"
            android:textStyle="bold" />
    </FrameLayout>

    <ImageView
        android:id="@+id/imgYeuThich"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:contentDescription="@string/heart_icon"
        android:src="@drawable/ic_yeuthich_do"
        android:layout_margin="20px"
        android:padding="4dp" />

</FrameLayout>
