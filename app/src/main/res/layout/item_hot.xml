<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/border"
        android:gravity="center">

        <ImageView
            android:id="@+id/imgSanPhamHot"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:src="@drawable/img_1"
            android:layout_marginTop="10dp"
            android:contentDescription="Hình ảnh sản phẩm"
            android:layout_gravity="center" />


        <TextView
            android:id="@+id/txtProductNameHot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="iPhone 15NA"
            android:textStyle="bold"
            android:textSize="10dp"
            android:paddingLeft="20dp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:gravity="center"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtPriceHot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10.000.000đ"
                android:textColor="#D32F2F"
                android:textStyle="bold"
                android:textSize="12dp"
                android:paddingTop="4dp" />

            <TextView
                android:id="@+id/tv_giaGoc_hot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10.000.000đ"
                android:layout_marginStart="10dp"
                android:textSize="8sp"
                android:paddingTop="4dp" />


        </LinearLayout>


    </LinearLayout>

    <ImageView
        android:id="@+id/imgHot"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|start"
        android:src="@drawable/ic_hot"
        android:layout_margin="8dp"
        android:padding="4dp" />

    <TextView
        android:id="@+id/tv_phanTram_hot"
        android:layout_width="50dp"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:background="@drawable/button_background2"
        android:padding="7dp"
        android:text="12"
        android:textSize="12dp"
        android:textColor="#E81B1B"
        android:layout_gravity="end" />

</FrameLayout>