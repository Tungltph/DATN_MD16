<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarChiTietDonHang"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#5FB1C1"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/border">

                <TextView
                    android:id="@+id/tvDeliveryDate"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Ngày giao hàng dự kiến"
                    android:textStyle="bold"
                    android:paddingBottom="4dp"/>
                <TextView
                    android:id="@+id/tvNgayNhanHangDuKien"
                    android:layout_width="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_height="wrap_content"
                    android:text="May 30 - May 31" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sản phẩm:"
                    android:textStyle="bold"
                    android:paddingBottom="4dp"/>

                <TextView
                    android:id="@+id/tvsoLuongHoaDon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FD0505"
                    android:layout_marginStart="5dp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp"/>

            </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="@drawable/border">

                <ImageView
                    android:id="@+id/ivHinhAnh"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/img_1"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTenDienThoai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="iPhone 15 Pro"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvMau"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Màu: Đen"
                        android:paddingTop="4dp" />

                    <TextView
                        android:id="@+id/tvTongtien"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15.000.000đ"
                        android:textColor="#FF00"
                        android:paddingTop="4dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Số lượng: 1"
                        android:paddingTop="4dp" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvDiaChi"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/border"
                    android:drawableStart="@drawable/diachi"
                    android:padding="10dp"
                    android:gravity="center_vertical"
                    android:text="Địa chỉ giao: Số nhà xx, phường xxx, Thành phố xx"
                    android:drawablePadding="8dp"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/tvSdt"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/border"
                    android:drawableStart="@drawable/phone"
                    android:padding="10dp"
                    android:gravity="center_vertical"
                    android:text="Số điện thoại người nhận: 09xxxxxxxx"
                    android:drawablePadding="8dp"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/tvTenKhachHang"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/border"
                    android:drawableStart="@drawable/tennguoinhan"
                    android:padding="10dp"
                    android:text="Tên người nhận: Nguyễn Văn A"
                    android:drawablePadding="8dp"
                    android:paddingBottom="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/border"
                android:padding="10dp"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvOrderDateTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Ngày đặt hàng"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tvNgayDatHang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="May 28, 2024 21:00 pm"
                        android:layout_marginEnd="10dp"
                        android:paddingBottom="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPaymentMethodTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Phương thức thanh toán:"
                        android:textStyle="bold"
                        android:paddingTop="8dp" />
                    <TextView
                        android:id="@+id/tvPhuongThucThanhToan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:text="Khi nhận hàng"
                        android:paddingBottom="16dp"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="30dp"
                android:layout_gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvTotalPriceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tổng tiền thanh toán cho đơn hàng là:"
                    android:textStyle="bold"
                    android:paddingEnd="8dp"/>

                <TextView
                    android:id="@+id/tvTongTienHoaDon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="15.000.000đ"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:background="@drawable/button_background"
                    android:padding="8dp"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
