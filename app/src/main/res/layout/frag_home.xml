<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F0F3F8">

    <!-- Content layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F0F3F8">

        <!-- Search bar and cart icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1700BCD4"
            android:padding="8dp"
            android:elevation="4dp">

            <TextView
                android:id="@+id/tvSearchHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Tìm kiếm sản phẩm..."
                android:padding="8dp"
                android:background="@drawable/search_background"
                android:drawableLeft="@drawable/search" />

            <ImageView
                android:id="@+id/idGioHangHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/baseline_shopping_cart_24"
                android:padding="8dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="80dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    xmlns:android="http://schemas.android.com/apk/res/android"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_margin="3dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/bannerViewPager"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:clipToPadding="false" />

                </androidx.cardview.widget.CardView>


                <!-- Category section -->
                <TextView
                    android:padding="8dp"
                    android:paddingStart="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F0F3F8"
                    android:text="Danh mục"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:background="#F2F2F2">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#F0F3F8"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            app:cardElevation="4dp"
                            app:cardCornerRadius="8dp">

                            <TextView
                                android:id="@+id/btnIphone"
                                android:layout_width="110dp"
                                android:gravity="center"
                                android:padding="10dp"
                                android:layout_height="wrap_content"
                                android:text="Iphone"
                                app:backgroundTint="@null"
                                android:textColor="@android:color/black" />

                        </androidx.cardview.widget.CardView>


                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            app:cardElevation="4dp"
                            app:cardCornerRadius="8dp">

                            <TextView
                                android:id="@+id/btnOppo"
                                android:layout_width="110dp"
                                android:gravity="center"
                                android:padding="10dp"
                                android:layout_height="wrap_content"
                                android:text="Oppo"
                                app:backgroundTint="@null"
                                android:textColor="@android:color/black" />

                        </androidx.cardview.widget.CardView>


                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            app:cardElevation="4dp"
                            app:cardCornerRadius="8dp">

                            <TextView
                                android:id="@+id/btnss"
                                android:layout_width="110dp"
                                android:gravity="center"
                                android:padding="10dp"
                                android:layout_height="wrap_content"
                                android:text="Samsung"
                                app:backgroundTint="@null"
                                android:textColor="@android:color/black" />

                        </androidx.cardview.widget.CardView>


                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            app:cardElevation="4dp"
                            app:cardCornerRadius="8dp">

                            <TextView
                                android:id="@+id/btnVivo"
                                android:layout_width="110dp"
                                android:gravity="center"
                                android:padding="10dp"
                                android:layout_height="wrap_content"
                                android:text="Vivo"
                                app:backgroundTint="@null"
                                android:textColor="@android:color/black" />

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="5dp"
                            app:cardElevation="4dp"
                            app:cardCornerRadius="8dp">

                            <TextView
                                android:id="@+id/btnXiaomi"
                                android:layout_width="110dp"
                                android:gravity="center"
                                android:padding="10dp"
                                android:layout_height="wrap_content"
                                android:text="Xiaomi"
                                app:backgroundTint="@null"
                                android:textColor="@android:color/black" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </HorizontalScrollView>


                <!-- Phần sản phẩm hot nhất -->
                <TextView
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hot nhất"
                    android:textSize="18sp"
                    android:paddingStart="20dp"
                    android:textStyle="bold"
                    android:background="#F0F3F8" />

                <!-- Phần sản phẩm mới nhất -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHotProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F0F3F8"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:scrollbars="none"
                    tools:listitem="@layout/item_hot" />

                <TextView
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:background="#F0F3F8"
                    android:layout_height="wrap_content"
                    android:text="Mới nhất"
                    android:paddingStart="20dp"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvNewProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:background="#F0F3F8"
                    android:scrollbars="none"
                    tools:listitem="@layout/item_new"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
