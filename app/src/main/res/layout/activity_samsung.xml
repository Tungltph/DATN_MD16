<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F3F8"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarSamsung"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#5FB1C1"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40px"
        android:padding="8dp">

        <EditText
            android:id="@+id/edtTimKiemSamsung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:hint="Tìm kiếm sam sung"
            android:padding="8dp"
            android:background="@drawable/border"
            android:drawableStart="@drawable/search"
            android:drawableEnd="@drawable/ic_clear"
            android:drawablePadding="8dp" />

    </RelativeLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#F2F2F2">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F0F3F8"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnIphone"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    android:text="Iphone"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnOppo"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    android:text="Oppo"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnss"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    android:text="Samsung"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnVivo"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    android:text="Vivo"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnXiaomi"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    android:text="Xiaomi"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:padding="8dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:background="#FFFFFF"
        android:scrollbars="none" />
</LinearLayout>
