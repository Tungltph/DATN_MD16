<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarTimKiem"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Light">
    </androidx.appcompat.widget.Toolbar>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40px"
        android:padding="8dp">

        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="8dp"
            android:hint="Tìm kiếm ..."
            android:padding="8dp"
            android:background="@drawable/ic_search_backgroud"
            android:drawableStart="@drawable/search"
            android:drawableEnd="@drawable/ic_clear"
            android:drawablePadding="8dp" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:background="#5C000000" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView
                android:id="@+id/btnLienQuan"
                android:layout_width="110dp"
                android:gravity="center"
                android:padding="10dp"
                android:layout_height="wrap_content"
                android:text="Liên quan"
                app:backgroundTint="@null"
                android:layout_margin="5dp"
                android:textColor="@android:color/black" />

            <View
                android:layout_width="1dp"
                android:layout_height="50dp"
                android:background="#5C000000" />



            <Spinner
                android:id="@+id/spinner_gia"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                app:backgroundTint="@null"
                android:entries="@array/spinner_items_gia" />

            <View
                android:layout_width="1dp"
                android:layout_height="50dp"
                android:background="#5C000000" />


            <TextView
                android:id="@+id/btnMoiNhat"
                android:layout_width="110dp"
                android:gravity="center"
                android:padding="10dp"
                android:layout_height="wrap_content"
                android:text="Mới nhất"
                app:backgroundTint="@null"
                android:layout_margin="5dp"/>
            <View
                android:layout_width="1dp"
                android:layout_height="50dp"
                android:background="#5C000000" />


            <TextView
                android:id="@+id/btnBanChay"
                android:layout_width="110dp"
                android:gravity="center"
                android:padding="10dp"
                android:layout_height="wrap_content"
                android:text="Bán chạy"
                app:backgroundTint="@null"
                android:layout_margin="5dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#5C000000" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_TimKiem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_no_results"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Không có sản phẩm phù hợp với từ khóa"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>
