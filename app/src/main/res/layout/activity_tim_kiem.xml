<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="#F0F3F8"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarTimKiem"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#5FB1C1"
        android:elevation="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        android:popupTheme="@style/ThemeOverlay.AppCompat.Light">
    </androidx.appcompat.widget.Toolbar>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40px"
        android:padding="8dp">

        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:hint="Tìm kiếm sản phẩm"
            android:padding="8dp"
            android:background="@drawable/border"
            android:drawableStart="@drawable/search"
            android:drawableEnd="@drawable/ic_clear"
            android:drawablePadding="8dp" />

    </RelativeLayout>



    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#F2F2F2">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F0F3F8"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnLienQuan"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="38dp"
                    android:text="Liên quan"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>




            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnMoiNhat"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    android:text="Mới nhất"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnBanChay"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="38dp"
                    android:text="Bán chạy"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>

<!--            <androidx.cardview.widget.CardView-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_margin="5dp"-->
<!--                app:cardElevation="4dp"-->
<!--                app:cardCornerRadius="8dp">-->

<!--                <Spinner-->
<!--                    android:id="@+id/spinner_gia"-->
<!--                    android:layout_width="120dp"-->
<!--                    android:layout_height="38dp"-->
<!--                    app:backgroundTint="@null"-->
<!--                    android:entries="@array/spinner_items_gia" />-->

<!--            </androidx.cardview.widget.CardView>-->

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnGia"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="38dp"
                    android:text="Giá "
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </HorizontalScrollView>




    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcv_TimKiem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F3F8"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tv_no_results"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Không có sản phẩm phù hợp với từ khóa"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>
