<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="80dp"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- TextView nằm giữa -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Đơn đã mua"
            android:textSize="20sp"
            android:layout_weight="1"
            android:gravity="center" />

        <!-- ImageView nằm bên phải -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/search"
            android:layout_marginEnd="10dp" /> <!-- Khoảng cách từ bên trái -->

    </LinearLayout>




    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#5C000000" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <View
                android:layout_width="1dp"
                android:layout_height="50dp"
                android:background="#5C000000" />

            <TextView
                android:id="@+id/btnChoXacNhan"
                android:layout_width="110dp"
                android:gravity="center"
                android:padding="10dp"
                android:layout_height="wrap_content"
                android:text="Chờ xác nhận"
                app:backgroundTint="@null"
                android:layout_margin="5dp"
                android:textColor="@android:color/black" />

            <View
                android:layout_width="1dp"
                android:layout_height="50dp"
                android:background="#5C000000" />

            <TextView
                android:id="@+id/btnChoGiaoHang"
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="Chờ giao hàng"
                app:backgroundTint="@null"
                android:textColor="@android:color/black" />

            <View
                android:layout_width="1dp"
                android:layout_height="50dp"
                android:background="#5C000000" />

            <TextView
                android:id="@+id/btnDangGiao"
                android:layout_width="110dp"
                android:gravity="center"
                android:padding="10dp"
                android:layout_height="wrap_content"
                android:text="Đang giao"
                app:backgroundTint="@null"
                android:layout_margin="5dp"
                android:textColor="@android:color/black" />

            <View
                android:layout_width="1dp"
                android:layout_height="50dp"
                android:background="#5C000000" />

            <TextView
                android:id="@+id/btnDaGiao"
                android:layout_width="110dp"
                android:gravity="center"
                android:padding="10dp"
                android:layout_height="wrap_content"
                android:text="Đã giao"
                app:backgroundTint="@null"
                android:layout_margin="5dp"
                android:textColor="@android:color/black" />

            <View
                android:layout_width="1dp"
                android:layout_height="50dp"
                android:background="#5C000000" />



            <TextView
                android:id="@+id/btnDaHuy"
                android:layout_width="110dp"
                android:gravity="center"
                android:padding="10dp"
                android:layout_height="wrap_content"
                android:text="Đã hủy"
                app:backgroundTint="@null"
                android:layout_margin="5dp"
                android:textColor="@android:color/black" />
            <View
                android:layout_width="1dp"
                android:layout_height="50dp"
                android:background="#5C000000" />
        </LinearLayout>
    </HorizontalScrollView>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#5C000000" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewOrders"
        android:layout_width="match_parent"
        android:layout_margin="10dp"
        android:layout_marginTop="10dp"
        android:layout_height="wrap_content" />

</LinearLayout>