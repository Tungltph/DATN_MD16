<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="#F0F3F8"
    android:layout_height="match_parent"
    android:layout_marginBottom="80dp"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40px"
        android:padding="8dp">

        <EditText
            android:id="@+id/edtTimKiemDonHang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:hint="Tìm kiếm đơn hàng"
            android:padding="8dp"
            android:background="@drawable/border"
            android:drawableStart="@drawable/search"
            android:drawableEnd="@drawable/ic_clear"
            android:drawablePadding="8dp" />

    </RelativeLayout>





    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#F2F2F2">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#F0F3F8"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnChoXacNhan"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    android:text="Chờ xác nhận"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnChoGiaoHang"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    android:text="Chờ giao hàng"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnDangGiao"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    android:text="Đang giao"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnDaGiao"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    android:text="Đã giao"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <TextView
                    android:id="@+id/btnDaHuy"
                    android:layout_width="110dp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:layout_height="wrap_content"
                    android:text="Đã hủy"
                    app:backgroundTint="@null"
                    android:textColor="@android:color/black" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </HorizontalScrollView>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewOrders"
        android:layout_width="match_parent"
        android:layout_margin="10dp"
        android:layout_marginTop="10dp"
        android:layout_height="wrap_content" />

</LinearLayout>