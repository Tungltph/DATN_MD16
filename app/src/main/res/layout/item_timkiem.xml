<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/border"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_product_image"
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/img_1"
                android:contentDescription="Hình ảnh sản phẩm"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/tv_ten_sanPham_timKiem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="iPhone 15NA"
                android:textStyle="bold"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:gravity="center"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_giamGia_timKiem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10.000.000đ"
                    android:textColor="#FF00"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/tv_giaGoc_timKiem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10.000.000đ"
                    android:layout_marginStart="10dp"
                    android:textSize="8sp"
                    android:paddingTop="4dp" />
            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:layout_gravity="end">

            <ImageView
                android:id="@+id/img_sale"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/img_7" />

            <TextView
                android:id="@+id/tv_phanTram_timKiem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="-12%"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>

    </FrameLayout>

</androidx.cardview.widget.CardView>
